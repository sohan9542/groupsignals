# --- Supabase (project: Groupsignals / zbbixoebumcwxnzmrzdr) ------------------
NEXT_PUBLIC_SUPABASE_URL=https://zbbixoebumcwxnzmrzdr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by the Apify and Paddle webhooks to write
# rows for a user who isn't making the request. Never prefix with NEXT_PUBLIC_.
# Supabase dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apify (public Facebook group scraping) -----------------------------------
# Server-only. apify.com > Settings > Integrations > API token.
APIFY_TOKEN=

# Shared secret echoed back by Apify's webhook so the endpoint can prove the
# call came from our own run. Any long random string.
APIFY_WEBHOOK_SECRET=

# Optional — override if the actor is renamed or you switch to your own.
APIFY_FACEBOOK_GROUP_ACTOR=apify~facebook-groups-scraper

# --- Apify (private Facebook group scraping, cookie-authenticated) ------------
# Optional — override if the actor is renamed or you switch to your own.
APIFY_PRIVATE_FACEBOOK_GROUP_ACTOR=whoareyouanas~facebook-group-scraper

# Server-only. 32 random bytes, base64-encoded — generate with:
#   openssl rand -base64 32
# Encrypts every cookie the admin adds to the pool in Settings. Rotating this
# key orphans the whole pool (every cookie becomes undecryptable, not just
# unusable) — treat it like a real secret.
FACEBOOK_COOKIE_ENCRYPTION_KEY=

# The one admin account, gated to /dashboard/settings (the cookie pool).
# Optional — defaults to foundersohan@gmail.com if unset.
ADMIN_EMAIL=foundersohan@gmail.com

# --- AI matching ----------------------------------------------------------------
# Server-only. console.anthropic.com > API Keys. Classifies scraped posts
# against each source's plain-English "notify me when..." intent.
ANTHROPIC_API_KEY=

# --- Email (lead alerts, admin cookie-ban alerts) --------------------------------
# Server-only. resend.com > API Keys.
RESEND_API_KEY=

# Must be on a domain verified in Resend. The shared onboarding@resend.dev
# sandbox address only delivers to the Resend account's own email — it will
# silently fail (or error) for real users, the same failure mode as the
# Supabase auth email did before a custom domain was set up.
EMAIL_FROM=

# --- Scheduled scans (Upstash QStash) -------------------------------------------
# Server-only. Any long random string (openssl rand -hex 32). /api/cron/scan
# checks this against an X-Cron-Secret header (or Authorization: Bearer).
CRON_SECRET=

# Server-only. console.upstash.com > QStash > token. When set, the app creates
# (and keeps updated) a 5-minute schedule that POSTs /api/cron/scan with
# X-Cron-Secret. Without this, only the daily Vercel Cron backup fires.
QSTASH_TOKEN=

# --- Paddle -------------------------------------------------------------------
# Client token is safe to expose; it only opens the checkout overlay.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Server-only — verifies the signature on /api/webhooks/paddle.
PADDLE_WEBHOOK_SECRET=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Public base URL that Apify can reach to call our webhook back. Falls back to
# NEXT_PUBLIC_SITE_URL / the Vercel production host. Set this to your deployed
# domain (or a tunnel) so local Scan now and QStash don't try to use localhost.
PUBLIC_WEBHOOK_BASE_URL=
